@model Cine.Web.Models.UpcomingMoviesViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Uskoro u kinima";
}

<section class="upcoming-hero">
    <p class="eyebrow">CINESTAR / MOSTAR</p>
    <h1>Coming <em>soon.</em></h1>
    <p class="hero-copy">Filmovi koji uskoro stižu na veliko platno.</p>
</section>

@if (Model.IsDataStale)
{
    <div class="data-notice" role="status">Showing data from @Model.DataFetchedAt?.ToLocalTime().ToString("g"). CineStar could not be refreshed.</div>
}
else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="data-notice data-error" role="alert">@Model.ErrorMessage</div>
}

<div class="results-heading upcoming-heading">
    <div>
        <p class="eyebrow">NAJAVA PROJEKCIJA</p>
        <h2>Uskoro <span>@Model.Movies.Count.ToString("00")</span></h2>
    </div>
    <p class="legend"><i></i> Najavljeni filmovi</p>
</div>

@if (Model.Movies.Count > 0)
{
    <section class="upcoming-grid">
        @foreach (var movie in Model.Movies)
        {
            <article class="upcoming-card">
                <div class="movie-index">@(Model.Movies.IndexOf(movie) + 1).0</div>
                <div class="upcoming-info">
                    <div class="title-line">
                        <h2>@movie.Title</h2>
                        @if (movie.Info?.Score is not null)
                        {
                            <span class="tmdb-score">★ @movie.Info.Score.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                        }
                        @if (movie.IsCartoon)
                        {
                            <span class="genre-tag">CARTOON</span>
                        }
                    </div>
                    <p class="description">@movie.Description</p>
                    @if (movie.Info?.Reviews is { Count: > 0 })
                    {
                        <div class="external-reviews">
                            @foreach (var review in movie.Info!.Reviews.Take(2))
                            {
                                <blockquote><p>&ldquo;@review.Quote&rdquo;</p><cite>@review.Author</cite></blockquote>
                            }
                        </div>
                    }
                    @if (movie.ReleaseDate is { } releaseDate)
                    {
                        <p class="release-date">Početak prikazivanja: @releaseDate.ToString("dd.MM.yyyy.")</p>
                    }
                    <div class="movie-links">
                        <a class="movie-link" href="@movie.DetailUrl" target="_blank" rel="noopener">View film details <span>↗</span></a>
                        @if (!string.IsNullOrEmpty(movie.Info?.ImdbUrl))
                        {
                            <a class="movie-link" href="@movie.Info!.ImdbUrl" target="_blank" rel="noopener">IMDb <span>↗</span></a>
                        }
                        @if (!string.IsNullOrEmpty(movie.Info?.LetterboxdUrl))
                        {
                            <a class="movie-link" href="@movie.Info!.LetterboxdUrl" target="_blank" rel="noopener">Letterboxd <span>↗</span></a>
                        }
                        @if (movie.Info is not null)
                        {
                            <button type="button" class="dialog-trigger" data-movie-dialog-open>More info</button>
                        }
                    </div>
                </div>
                @if (movie.ReleaseDate is { } badgeDate)
                {
                    <div class="coming-badge"><strong>@badgeDate.ToString("dd.MM.")</strong><br />@badgeDate.ToString("yyyy.")</div>
                }
                else
                {
                    <div class="coming-badge">COMING<br />SOON</div>
                }
                @if (movie.Info is not null)
                {
                    <dialog class="movie-dialog" data-movie-dialog>
                        <div class="movie-dialog-body">
                            <div class="title-line">
                                <h3>@movie.Title</h3>
                                @if (movie.Info!.Score is not null)
                                {
                                    <span class="tmdb-score">★ @movie.Info.Score.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(movie.Info.Overview))
                            {
                                <p class="dialog-eyebrow">TMDB DESCRIPTION</p>
                                <p class="dialog-overview">@movie.Info.Overview</p>
                            }
                            @if (movie.Info.Reviews is { Count: > 0 })
                            {
                                <p class="dialog-eyebrow">REVIEWS</p>
                                <div class="external-reviews dialog-reviews">
                                    @foreach (var review in movie.Info.Reviews)
                                    {
                                        <blockquote><p>&ldquo;@(string.IsNullOrEmpty(review.Content) ? review.Quote : review.Content)&rdquo;</p><cite>@review.Author</cite></blockquote>
                                    }
                                </div>
                            }
                            <div class="movie-links dialog-links">
                                @if (!string.IsNullOrEmpty(movie.Info.ImdbUrl))
                                {
                                    <a class="movie-link" href="@movie.Info.ImdbUrl" target="_blank" rel="noopener">IMDb <span>↗</span></a>
                                }
                                @if (!string.IsNullOrEmpty(movie.Info.LetterboxdUrl))
                                {
                                    <a class="movie-link" href="@movie.Info.LetterboxdUrl" target="_blank" rel="noopener">Letterboxd <span>↗</span></a>
                                }
                                <a class="movie-link" href="@movie.DetailUrl" target="_blank" rel="noopener">CineStar <span>↗</span></a>
                                <button type="button" class="dialog-close" data-movie-dialog-close>Close</button>
                            </div>
                        </div>
                    </dialog>
                }
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <strong>Nema najavljenih filmova.</strong>
        <span>Nova izdanja pojavit će se ovdje čim budu najavljena.</span>
    </div>
}
