@model List<Cine.Models.Movie>

@{
    ViewData["Title"] = "Uskoro u kinima";
}

<section class="upcoming-hero">
    <p class="eyebrow">CINESTAR / MOSTAR</p>
    <h1>Coming <em>soon.</em></h1>
    <p class="hero-copy">Filmovi koji uskoro stižu na veliko platno.</p>
</section>

<div class="results-heading upcoming-heading">
    <div>
        <p class="eyebrow">NAJAVA PROJEKCIJA</p>
        <h2>Uskoro <span>@Model.Count.ToString("00")</span></h2>
    </div>
    <p class="legend"><i></i> Najavljeni filmovi</p>
</div>

@if (Model.Count > 0)
{
    <section class="upcoming-grid">
        @foreach (var movie in Model)
        {
            <article class="upcoming-card">
                <div class="movie-index">@(Model.IndexOf(movie) + 1).0</div>
                <div class="upcoming-info">
                    <div class="title-line">
                        <h2>@movie.Title</h2>
                        @if (movie.IsCartoon)
                        {
                            <span class="genre-tag">CARTOON</span>
                        }
                    </div>
                    <p class="description">@movie.Description</p>
                    <a class="movie-link" href="@movie.DetailUrl" target="_blank" rel="noopener">View film details <span>↗</span></a>
                </div>
                <div class="coming-badge">COMING<br />SOON</div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <strong>Nema najavljenih filmova.</strong>
        <span>Nova izdanja pojavit će se ovdje čim budu najavljena.</span>
    </div>
}
