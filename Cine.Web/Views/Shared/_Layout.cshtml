<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - CineStar Mostar</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body>
<header class="site-header"><a asp-controller="Movies" asp-action="Index" class="brand"><span class="brand-mark">C</span> CINESTAR <small>MOSTAR</small></a><span class="header-note">MOVIE SCHEDULE <b>●</b></span></header>
<div class="page-shell"><main role="main">@RenderBody()</main></div>
<footer class="site-footer"><div>Curated from CineStar Mostar</div><div>© 2026 CINESTAR</div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
